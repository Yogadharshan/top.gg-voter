# Required: Lara's Top.gg / Discord bot ID (15-20 digit snowflake)
LARA_TOPGG_BOT_ID=REPLACE_WITH_YOUR_LARA_BOT_ID

# Required: Top.gg Webhooks v1 signing secret
TOPGG_WEBHOOK_SECRET=replace-with-your-topgg-webhook-secret

# Optional: HTTP port (default 3000)
PORT=3000

# Optional: directory for received-votes.jsonl (default ./data)
# DATA_DIR=./data
